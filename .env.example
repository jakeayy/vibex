# Copy this file to .env and fill in the values. .env is gitignored.
# These credentials are only needed for publishing, not for building VibeX.

# --- Firefox / addons.mozilla.org  (npm run sign:firefox) ---
# API key + secret from https://addons.mozilla.org/developers/addon/api/key/
AMO_JWT_ISSUER=
AMO_JWT_SECRET=

# --- Chrome Web Store  (npm run publish:chrome) ---
# An OAuth client (type "Web application") in a Google Cloud project with the
# Chrome Web Store API enabled, plus a refresh token for the scope
# https://www.googleapis.com/auth/chromewebstore . See README "Publishing for Chrome".
CHROME_CLIENT_ID=
CHROME_CLIENT_SECRET=
CHROME_REFRESH_TOKEN=
CHROME_PUBLISHER_ID=        # Dashboard -> Publisher -> Settings
CHROME_EXTENSION_ID=        # the item's id, from its dashboard/store URL
